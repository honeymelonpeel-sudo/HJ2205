    if n and n > 0 then
        FLING_POWER = n
        PowerBox.Text = tostring(n)
    else
        PowerBox.Text = tostring(FLING_POWER)
    end
end)

local function getRoot(char)
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

local currentRoot
local bodyVel
local bodyGyro
local bodyAV

local function enableStableCore()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = getRoot(char)
    if not hum or not root then return end

    hum:SetStateEnabled(Enum.HumanoidStateType.Dead,false)
    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Physics,false)

    local prt = Instance.new("Model")
    prt.Parent = char

    local z1 = Instance.new("Part",prt)
    z1.Name = "Torso"
    z1.Anchored = true
    z1.CanCollide = false
    z1.Transparency = 1

    local z2 = Instance.new("Part",prt)
    z2.Name = "Head"
    z2.Anchored = true
    z2.CanCollide = false
    z2.Transparency = 1

    local z3 = Instance.new("Humanoid",prt)

    z1.Position = Vector3.new(0,9999,0)
    LocalPlayer.Character = prt
    task.wait(3)
    LocalPlayer.Character = char
    task.wait(3)

    currentRoot = getRoot(char)
    for _,v in pairs(char:GetChildren()) do
        if v ~= currentRoot and v.Name ~= "Humanoid" then
            v:Destroy()
        end
    end

    currentRoot.Transparency = 0
    currentRoot.Material = Enum.Material.Neon
    currentRoot.Color = Color3.new(1,1,1)

    RunService.Stepped:Connect(function()
        if char and currentRoot then
            for _,p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                end
            end
        end
    end)

    bodyGyro = Instance.new("BodyGyro",currentRoot)
    bodyGyro.P = 9e4
    bodyGyro.MaxTorque = Vector3.new(9e9,9e9,9e9)

    bodyVel = Instance.new("BodyVelocity",currentRoot)
    bodyVel.MaxForce = Vector3.new(9e9,9e9,9e9)
    bodyVel.Velocity = Vector3.zero

    bodyAV = Instance.new("BodyAngularVelocity",currentRoot)
    bodyAV.MaxTorque = Vector3.new(math.huge,math.huge,math.huge)
    bodyAV.P = math.huge

    RunService.Heartbeat:Connect(function()
        if bodyAV and bodyAV.Parent then
            bodyAV.AngularVelocity = Vector3.new(
                math.random(-2000,2000),
                math.random(-2000,2000),
                math.random(-2000,2000)
            )
        end
    end)

    task.spawn(function()
        while char.Parent and hum.Health > 0 do
            bodyGyro.CFrame = Workspace.CurrentCamera.CFrame
            local dir = hum.MoveDirection
            bodyVel.Velocity = dir * 50
            Workspace.CurrentCamera.CameraSubject = currentRoot
            RunService.RenderStepped:Wait()
        end
    end)
end

local function flingPulse()
    while hiddenfling do
        RunService.Heartbeat:Wait()
        if currentRoot then
            local v = currentRoot.Velocity
            currentRoot.Velocity = v * FLING_POWER + Vector3.new(0,FLING_POWER,0)
            RunService.RenderStepped:Wait()
            currentRoot.Velocity = v
        end
    end
end

local function targetFling(player,button)
    task.spawn(function()
        while targetFlings[player.Name] do
            if player.Character and currentRoot then
                local th = getRoot(player.Character)
                if th then
                    currentRoot.CFrame = CFrame.new(th.Position + th.CFrame.LookVector * 0.5) * currentRoot.CFrame.Rotation
                    local v = currentRoot.Velocity
                    currentRoot.Velocity = v * FLING_POWER + Vector3.new(0,FLING_POWER,0)
                    RunService.RenderStepped:Wait()
                    currentRoot.Velocity = v
                end
            end
            RunService.Heartbeat:Wait()
        end
        if button then
            button.Text = "甩飞："..player.Name
            button.BackgroundColor3 = Color3.fromRGB(85,170,255)
        end
    end)
end

TextButton.MouseButton1Click:Connect(function()
    hiddenfling = not hiddenfling
    TextButton.Text = hiddenfling and "ON" or "OFF"
    TextButton.BackgroundColor3 = hiddenfling and Color3.fromRGB(85,255,127) or Color3.fromRGB(255,255,255)
    if hiddenfling then
        enableStableCore()
        task.spawn(flingPulse)
    end
end)

local function createPlayerButton(player)
    local b = Instance.new("TextButton")
    b.Parent = PlayerListFrame
    b.BackgroundColor3 = Color3.fromRGB(85,170,255)
    b.BorderSizePixel = 0
    b.Size = UDim2.new(0.9,0,0,35)
    b.Font = Enum.Font.Gotham
    b.Text = "甩飞："..player.Name
    b.TextColor3 = Color3.fromRGB(255,255,255)
    b.TextSize = 14
    b.MouseButton1Click:Connect(function()
        if not targetFlings[player.Name] then
            targetFlings[player.Name] = true
            b.Text = "停止："..player.Name
            b.BackgroundColor3 = Color3.fromRGB(255,127,80)
            targetFling(player,b)
        else
            targetFlings[player.Name] = nil
        end
    end)
    return b
end

local function updatePlayerList()
    for _,c in pairs(PlayerListFrame:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    local y = 5
    for _,p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local b = createPlayerButton(p)
            b.Position = UDim2.new(0.05,0,0,y)
            y += 40
        end
    end
    PlayerListFrame.CanvasSize = UDim2.new(0,0,0,y)
end

updatePlayerList()
Players.PlayerAdded:Connect(function() task.wait(0.5) updatePlayerList() end)
Players.PlayerRemoving:Connect(function(p) targetFlings[p.Name]=nil task.wait(0.5) updatePlayerList() end)